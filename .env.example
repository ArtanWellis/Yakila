# Environnement de développement : projet Supabase cloud (pas de base locale).
# Copier vers apps/web/.env.local et apps/mobile/.env (jamais committé).
# URL et clé « publishable » (sb_publishable_…) : Dashboard Supabase > Project Settings > API Keys.

# Web (Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL publique du site (URL canoniques et Open Graph). Facultatif en local, obligatoire en production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mobile (Expo)
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# SERVEUR UNIQUEMENT (Edge Functions, scripts). Jamais préfixée NEXT_PUBLIC_ / EXPO_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=
