# Copier vers apps/web/.env.local et apps/mobile/.env (jamais committé).
# Valeurs affichées par `pnpm supabase status` après `pnpm supabase start`.

# Web (Next.js)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mobile (Expo)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# SERVEUR UNIQUEMENT (Edge Functions, scripts). Jamais préfixée NEXT_PUBLIC_ / EXPO_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=
